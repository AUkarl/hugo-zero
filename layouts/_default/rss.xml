{{- /* ============================================================
  rss.xml — RSS 订阅模板
  ------------------------------------------------------------
  输出策略（可在 config/_default/params.toml 的 [rss] 下调整）：
  - full_content = true  正文字段输出「完整正文」而不是截断摘要
  - 图片、代码块、列表、表格、公式（$...$ 原文）等全部保留
  - 视频/音乐类短代码（iframe、audio 播放器、网易云占位脚本）会被剔除，
    因为这些内容在阅读器里无法播放，且内嵌 <script> 会破坏 feed 结构
  - 正文同时写入 <description> 与 <content:encoded>（兼容各类阅读器）
  - limit 控制条目数量，默认 50
  ============================================================ */ -}}
{{- $rss := .Site.Params.rss | default dict -}}
{{- if $rss.enable | default true -}}
{{- $full := $rss.full_content | default true -}}
{{- $limit := $rss.limit | default 50 -}}
{{- $embedRe := `(?s)<div[^>]*class="[^"]*(?:video-embed|shortcode-embed|music163-embed|bilibili-embed|netease-music|kugou-music|qq-music|bilibili-video|tencent-video)[^"]*"[^>]*>.*?</div>` -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default (printf "Recent content on %s" .Site.Title) }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end -}}
    {{- range (where site.RegularPages "Type" "in" (slice "post" "posts" "article" "blog" "shuo")) | first $limit }}
    {{- $html := .Summary -}}
    {{- if $full }}{{ $html = .Content }}{{ end -}}
    {{- /* ---------- 封面：给阅读器一个"原图直链" ----------
           阅读器普遍不认 WebP、也不会执行懒加载 JS，所以这里直接用封面原始地址
           （例如 R2 上那张 jpg/png），而不是构建时生成的 WebP，否则会出现"不显示"或
           "只有一张特别小的模糊图"的问题。
           注意：这里刻意不再调用 img-src.html —— 那会为每篇文章做一次远程取图，
           既拖慢构建又多一次网络依赖；直接用原地址转绝对路径就够了。 */ -}}
    {{- $cover := .Params.image | default .Params.img -}}
    {{- $coverURL := "" -}}
    {{- with $cover -}}{{- $coverURL = . | absURL -}}{{- end -}}
    {{- if and $full $coverURL (not (in $html "<img")) -}}
      {{- $html = printf "<p><img src=%q alt=%q loading=\"lazy\"></p>%s" $coverURL (.Title | plainify) $html -}}
    {{- end -}}
    {{- /* ---------- 正文图片：把懒加载属性换成真实原图 ----------
           管线输出的 <img> 只有 data-src（WebP），外加一张内联的模糊占位图。
           阅读器不跑 JS，于是正文图要么空白、要么只剩那张极小的占位图。
           这里统一：占位图删掉，data-orig（原图）优先，其次 data-src，最后 src。 */ -}}
    {{- $html = replaceRE `(?s)<img\b[^>]*class="[^"]*img-pair-lqip[^"]*"[^>]*>` "" $html -}}
    {{- range findRE `(?s)<img\b[^>]*>` $html -}}
      {{- $tag := . -}}
      {{- $u := "" -}}
      {{- with (findRE `data-orig="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*data-orig="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}
      {{- if not $u -}}{{- with (findRE `data-src="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*data-src="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}{{- end -}}
      {{- if not $u -}}{{- with (findRE `[[:space:]]src="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*[[:space:]]src="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}{{- end -}}
      {{- $alt := "" -}}
      {{- with (findRE `alt="([^"]*)"` $tag 1) -}}{{- $alt = replaceRE `(?s).*alt="([^"]*)".*` "$1" (index . 0) -}}{{- end -}}
      {{- if and $u (not (hasPrefix $u "data:")) -}}
        {{- $html = replace $html $tag (printf `<img src="%s" alt="%s" loading="lazy">` ($u | absURL) $alt) -}}
      {{- else -}}
        {{- $html = replace $html $tag "" -}}
      {{- end -}}
    {{- end -}}
    {{- /* ---------- 视频/音频：阅读器里播不了，改成可点的超链接 ----------
           （原来是整块删掉，订阅者完全看不到；现在至少给一个能点开的链接） */ -}}
    {{- $html = replaceRE `(?s)<(?:video|audio)\b[^>]*>.*?<source\b[^>]*[[:space:]]src="([^"]+)"[^>]*>.*?</(?:video|audio)>` `<p>▶ <a href="$1">$1</a></p>` $html -}}
    {{- $html = replaceRE `(?s)<iframe\b[^>]*[[:space:]]src="([^"]+)"[^>]*>(?:.*?</iframe>)?` `<p>▶ <a href="$1">$1</a></p>` $html -}}
    {{- $html = replace $html `href="//` `href="https://` -}}
    {{- /* 剔除脚本、残留的嵌入容器与无用的空标签（保留 <img>、<a> 等正文元素） */ -}}
    {{- $html = replaceRE `(?s)<script\b[^>]*>.*?</script>` "" $html -}}
    {{- $html = replaceRE $embedRe "" $html -}}
    {{- $html = replaceRE `(?s)<iframe\b.*?</iframe>` "" $html -}}
    {{- $html = replaceRE `(?s)<audio\b.*?</audio>` "" $html -}}
    {{- $html = replaceRE `(?s)<video\b.*?</video>` "" $html -}}
    {{- $html = replaceRE `(?s)<!--.*?-->` "" $html -}}
    {{- /* XMLEscape 后由阅读器还原成 HTML：这是 RSS 的规范做法，避免 feed 结构非法 */ -}}
    {{- $html = $html | transform.XMLEscape -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- with .Params.author }}
      <dc:creator>{{ . }}</dc:creator>
      {{- end }}
      {{- /* categories / tags 兼容两种写法：列表 或 单个字符串 */ -}}
      {{- with .Params.categories -}}
        {{- if reflect.IsSlice . -}}{{- range . }}<category>{{ . }}</category>{{ end -}}
        {{- else }}<category>{{ . }}</category>{{ end -}}
      {{- end -}}
      {{- with .Params.tags -}}
        {{- if reflect.IsSlice . -}}{{- range . }}<category>{{ . }}</category>{{ end -}}
        {{- else }}<category>{{ . }}</category>{{ end -}}
      {{- end }}
      <description>{{ $html | safeHTML }}</description>
      <content:encoded>{{ $html | safeHTML }}</content:encoded>
      {{- /* 封面以 enclosure / media:thumbnail 形式给出来：多数阅读器用这两个字段显示列表缩略图 */ -}}
      {{- with $coverURL }}
      {{- $ctype := "image/jpeg" -}}
      {{- if strings.HasSuffix . ".png" }}{{ $ctype = "image/png" }}{{ else if strings.HasSuffix . ".webp" }}{{ $ctype = "image/webp" }}{{ else if strings.HasSuffix . ".gif" }}{{ $ctype = "image/gif" }}{{ else if strings.HasSuffix . ".avif" }}{{ $ctype = "image/avif" }}{{ end -}}
      <enclosure url="{{ . }}" type="{{ $ctype }}" length="0" />
      <media:thumbnail url="{{ . }}" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
{{- else -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Site.BaseURL }}</link>
    <description>RSS is disabled.</description>
  </channel>
</rss>
{{- end -}}
